# dashboard — مغسلة staff + platform Super Admin  (Vercel → Environment Variables)

# your deployed backend, WITH the /v1 suffix
VITE_API_URL="http://localhost:4000/v1"

# tenant slug used for the anonymous /auth/refresh + /auth/*/login calls.
# staff & platform JWTs carry their own tenant after login, so this only
# needs to be a valid slug (keep "demo" unless you know otherwise).
VITE_TENANT_SLUG="demo"

# Customer website shared by all tenant links
VITE_WEB_URL="https://web-car-washing.vercel.app"
